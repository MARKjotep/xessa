/*
 * Base theme module: runtime defaults and the only @keyframes block.
 * entry.cssx imports it first, then theme-alt.cssx, which is why theme-alt
 * would win the module merge order if the entry did not override `primary`.
 */
@setup { prefix: "ui"; module: true; }

@runtime {
  primary: #2563eb @dark #60a5fa;
  surface: #ffffff @dark #0f172a;
  on-surface: #0f172a @dark #e2e8f0;
}

@keyframes fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.base-card {
  color: $on-surface;
  background: $surface;
}
