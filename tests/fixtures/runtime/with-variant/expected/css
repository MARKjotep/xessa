:root {
  --ui-surface: #ffffff;
  --ui-accent: #ec4899;
}

@media (prefers-color-scheme: dark) {
  :root {
    --ui-surface: #111111;
  }
}

@media (min-width: 768px) {
  :root {
    --ui-accent: #db2777;
  }
}

@media (prefers-color-scheme: dark) and (min-width: 768px) {
  :root {
    --ui-accent: #be185d;
  }
}

.ui-card {
  background: var(--ui-surface);
  color: var(--ui-accent);
}
