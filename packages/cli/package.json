{
  "name": "@xessa/cli",
  "version": "0.1.3",
  "description": "Xessa command line interface: build, check, watch, format and clean.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MARKjotep/xessa.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/MARKjotep/xessa#readme",
  "bugs": {
    "url": "https://github.com/MARKjotep/xessa/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xessa/compiler": "0.1.3"
  },
  "bin": {
    "xessa": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"const fs=require('node:fs');if(process.platform!=='win32')fs.chmodSync('dist/index.js',0o755)\""
  }
}
