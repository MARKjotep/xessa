{
  "name": "@xessa/compiler",
  "version": "0.1.3",
  "description": "Xessa lexer, parser, resolver, transformer and CSS/JS generators. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MARKjotep/xessa.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/MARKjotep/xessa#readme",
  "bugs": {
    "url": "https://github.com/MARKjotep/xessa/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "SPECIFICATION.md", "docs"],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepack": "node ../../scripts/sync-package-docs.mjs"
  }
}
