.ui-button {
  display: flex;
  padding: 12px;
}

@media (min-width: 768px) {
  .ui-button {
    padding: 20px;
  }
}

@media (min-width: 1280px) {
  .ui-button {
    padding: 32px;
  }
}

.ui-button {
  border-radius: 8px;
  background: #2563eb;
}

@media (prefers-color-scheme: dark) {
  .ui-button {
    background: #1e40af;
  }
}

.ui-button {
  font-size: 14px;
}

@media (min-width: 768px) {
  .ui-button {
    font-size: 16px;
  }
}

.ui-button:hover {
  opacity: 0.85;
}

.ui-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.ui-button > .ui-icon {
  width: 16px;
}

@media (min-width: 1024px) {
  .ui-button > .ui-icon {
    width: 20px;
  }
}
