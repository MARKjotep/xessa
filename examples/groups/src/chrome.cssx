/*
* Shared group definitions for this example. The entry imports this module with
* `styles` — the only import form that exposes groups (ADR-0017 decision (a));
* a token-only import would expose none.
*
* Defaults are compile-time only (decision (b)): they may reference @variables
* values, never @runtime tokens. These tokens resolve in THIS module, so the
* entry's local `chrome-padding: 40px` cannot leak into the defaults below.
*/
@setup {
  module: true;
}

@variables {
  chrome-padding: 12px;
  chrome-radius: 8px;
  chrome-border: #d4d4d8;
  elevated-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  elevated-surface: #ffffff;
}

/*
* Card chrome: one definition, customized per use site. The `!important` on
* box-sizing is deliberate — ADR-0003 binds it per value segment, so a plain
* use-site declaration cannot override it (see `.framed` in entry.cssx).
*/
@group.chrome {
  padding: $chrome-padding;
  border-radius: $chrome-radius;
  border: 1px solid $chrome-border;
  box-sizing: border-box !important;
}

/*
* Elevation with an inline variant default: 12px below 768px, 20px from 768px
* up. Expansion keeps the segments in authored order (ADR-0017).
*/
@group.elevated {
  box-shadow: $elevated-shadow;
  background: $elevated-surface;
  padding: $chrome-padding @md 20px;
}
