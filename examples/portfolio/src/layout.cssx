/*
* Page shell: global elements, container, header/nav, section scaffolding and
* footer. The token module is imported under three aliases so declarations read
* `$color.ink`, `$space.section` and `$font.display`; `theme` stays namespaced
* for runtime custom properties.
*/
@setup {
  prefix: "pf";
  module: true;
}

@use "./tokens.cssx" as color;

@use "./tokens.cssx" as space;

@use "./tokens.cssx" as font;

@use "./theme.cssx" as theme;

html {
  color-scheme: light dark;
  scroll-behavior: smooth;

  @reduced {
    scroll-behavior: auto;
  }
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: $theme.canvas;
  color: $theme.ink;
  font-family: $font.sans;
  font-size: $font.size-md;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

a {
  color: inherit;
}

::selection {
  background: $theme.accent;
  color: $theme.accent-ink;
}

/* Keyboard escape hatch shown only while focused. */
.skip-link {
  position: absolute;
  left: 16px;
  top: -72px;
  z-index: 50;
  padding: 10px 16px;
  border-radius: 10px;
  background: $theme.ink;
  color: $theme.canvas;
  font-size: $font.size-sm;
  text-decoration: none;

  &:focus {
    top: 12px;
  }
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
  border: 0;
}

.container {
  width: min(1160px, calc(100% - 2 * $space.gutters));
  margin-inline: auto;
}

/* Sticky header: opaque canvas fallback, translucent blur where supported. */
.site-header {
  position: static;
  z-index: 30;
  border-bottom: 1px solid $theme.border;
  background: $theme.canvas;
  background: color-mix(in srgb, $theme.canvas 86%, transparent);
  backdrop-filter: blur(16px);

  @md {
    position: sticky;
    top: 0;
  }
}

.header-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px;
  min-height: 72px;
  padding-block: 12px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-right: auto;
  text-decoration: none;

  &:focus-visible {
    outline: 2px solid $theme.accent;
    outline-offset: 4px;
    border-radius: 12px;
  }
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 12px;
  background: $theme.accent;
  color: $theme.accent-ink;
  font-family: $font.display;
  font-size: 1.05rem;
  font-weight: 600;
  letter-spacing: -0.04em;
}

.brand-text {
  display: flex;
  flex-direction: column;
  line-height: 1.15;
}

.brand-name {
  font-family: $font.display;
  font-size: 1.02rem;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.brand-role {
  color: $theme.muted;
  font-size: 0.68rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

/* Below md the nav wraps onto its own scrollable row. */
.nav {
  order: 3;
  width: 100%;
  overflow-x: auto;

  @md {
    order: 0;
    width: auto;
    overflow: visible;
  }
}

.nav-list {
  display: flex;
  gap: 4px;
  margin: 0;
  padding: 4px 0;
  list-style: none;
}

.nav-link {
  display: inline-flex;
  padding: 8px 12px;
  border-radius: 999px;
  color: $theme.muted;
  font-size: $font.size-sm;
  text-decoration: none;
  white-space: nowrap;
  transition: color 160ms ease, background-color 160ms ease;

  &:hover {
    background: $theme.surface;
    color: $theme.ink;
  }

  &:focus-visible {
    outline: 2px solid $theme.accent;
    outline-offset: 2px;
  }
}

.theme-control {
  display: inline-flex;
  gap: 2px;
  padding: 4px;
  border: 1px solid $theme.border;
  border-radius: 999px;
  background: $theme.surface;
}

.theme-button {
  appearance: none;
  padding: 6px 10px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: $theme.muted;
  font: inherit;
  font-size: 0.68rem;
  letter-spacing: 0.04em;
  cursor: pointer;

  &[aria-pressed="true"] {
    background: $theme.ink;
    color: $theme.canvas;
  }

  &:focus-visible {
    outline: 2px solid $theme.accent;
    outline-offset: 2px;
  }
}

.page-main {
  display: block;
  overflow-x: clip;
}

.section {
  padding-block: 72px;
  border-top: 1px solid $theme.border;

  @md {
    padding-block: $space.section;
  }
}

.section-head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14px;
  margin-bottom: 36px;

  @md {
    margin-bottom: 56px;
  }
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin: 0;
  color: $theme.accent;
  font-family: $font.mono;
  font-size: 0.68rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;

  &::before {
    content: "";
    width: 26px;
    height: 1px;
    background: currentColor;
  }
}

.section-title {
  max-width: 20ch;
  margin: 0;
  font-family: $font.display;
  font-size: clamp(1.9rem, 4.4vw, 2.8rem);
  font-weight: 600;
  letter-spacing: -0.025em;
  line-height: 1.06;
  text-wrap: balance;
}

.section-lead {
  max-width: 62ch;
  margin: 0;
  color: $theme.muted;
  font-size: $font.size-md;

  @md {
    font-size: 1.06rem;
  }
}

.site-footer {
  padding-block: 36px;
  border-top: 1px solid $theme.border;
}

.footer-inner {
  display: flex;
  flex-direction: column;
  gap: 18px;

  @md {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

.footer-meta {
  margin: 0;
  color: $theme.muted;
  font-size: $font.size-sm;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.footer-link {
  color: $theme.ink;
  font-size: $font.size-sm;
  text-decoration: none;

  &:hover {
    color: $theme.accent;
  }

  &:focus-visible {
    outline: 2px solid $theme.accent;
    outline-offset: 2px;
  }
}

.footer-note {
  margin: 0;
  color: $theme.faint;
  font-family: $font.mono;
  font-size: 0.68rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
