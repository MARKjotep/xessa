.card {
  padding: 12px;
}

@media (min-width: 768px) {
  .card {
    padding: 20px;
  }
}

@media (min-width: 1280px) {
  .card {
    padding: 32px;
  }
}

.card {
  background: white;
}

@media (prefers-color-scheme: dark) {
  .card {
    background: #181818;
  }
}

@media (min-width: 1280px) and (prefers-color-scheme: dark) {
  .card {
    background: #101010;
  }
}

@media (min-width: 1280px) {
  .card {
    display: grid;
    gap: 24px;
  }
}

@media (max-width: 500px) {
  .card {
    display: block;
  }
}
